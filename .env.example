# ---- Radio Suomi: Death Metal Edition -------------------------------------

# Port the server listens on (Railway sets PORT automatically).
PORT=3000

# The YLE Radio Suomi live stream URL. Anything ffmpeg can read works:
# HLS (.m3u8), Icecast/MP3, etc. YLE changes these occasionally and they are
# geo-restricted to Finland, so update this if playback/detection fails.
# Find a current one at https://fmstream.org/index.php?c=FIN or yle-api projects.
YLE_STREAM_URL=https://yleradiolive.akamaized.net/hls/live/2027674/in-YleRS/master.m3u8

# Bitrate of the MP3 re-served to the browser.
STREAM_BITRATE=128k

# ---- Detection tuning (can also be changed live from the web UI) ----------

# Music probability (0..1) above which a segment is treated as music.
# Lower = more eager to call something "music" (more death metal).
MUSIC_THRESHOLD=0.55

# Seconds the new state must persist before the detector switches (anti-flap).
SWITCH_HOLD_SECONDS=3

# ---- Death metal source (optional defaults; also editable in the UI) ------

# A YouTube playlist ID (the part after list= in a playlist URL). If set, this
# is used and shuffled. Leave empty to configure from the web UI instead.
YT_PLAYLIST_ID=

# Comma-separated YouTube video IDs as a fallback if no playlist is set.
YT_VIDEO_IDS=
